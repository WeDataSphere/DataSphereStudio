{
  "apps": {
    "scriptis": {
      "routes": "scriptis/router",
      "module": "scriptis/module",
      "i18n": {
        "en": "scriptis/i18n/common/en.json",
        "zh-CN": "scriptis/i18n/common/zh.json"
      }
    }
  },
  "exts": {
    "dss-plugin-webank": {
      "module": "exts/webank/index.js",
      "i18n": {
        "en": "exts/webank/i18n/en.json",
        "zh-CN": "exts/webank/i18n/zh.json"
      },
      "options": null
    },
    "dss-plugin-scriptisGuide": {
      "module": "exts/scriptisGuide/index.js",
      "i18n": {
        "en": "exts/scriptisGuide/i18n/en.json",
        "zh-CN": "exts/scriptisGuide/i18n/zh.json"
      },
      "options": {
        "getUserStage": "/dss/scriptis/getUserStage"
      }
    }
  },
  "components": {
    "WeEditorLsp": "editorLsp/index.js",
    "WeEditor": "editor/index.js"
  },
  "conf": {
    "app_name": "DataSphere Studio",
    "app_logo": "dss/assets/images/smart-ds-white.svg",
    "handbook": "/_book",
    "copy_project_enable": true,
    "error_report": true,
    "table_transfer": true,
    "watermark": {
      "show": true,
      "template": "${username} ${time}",
      "timeupdate": 60000
    },
    "update_chrome": "/知识库/DSS常见问题/其他/DSS使用推荐的浏览器版本.html",
    "lsp_service": {
      "sql": "${protocol}//${host}/server",
      "py": "${protocol}//${host}/python"
    }
  },
  "version": "1.19.8"
}