{
  "name": "dataspherestudio",
  "version": "1.16.0",
  "wbSubSystem": "DSS-WFS",
  "private": true,
  "scripts": {
    "sync": "node script/fetchProject.js gitUrl=git@code.weoa.com:Internal/dataspherestudio-wedatasphere-sync.git##dirName=web/packages/##branchName=dev-1.11.0",
    "serve": "patch-package && cd packages/dss && npm run serve",
    "serve-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run serve",
    "build": "patch-package && cd packages/dss && npm run build",
    "build-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run build",
    "serve-sit": "patch-package && cd packages/dss && npm run serve-sit",
    "serve-sit-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run serve-sit",
    "serve-uat": "patch-package && cd packages/dss && npm run serve-uat",
    "serve-uat-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run serve-uat",
    "build-sit": "patch-package && cd packages/dss && npm run build-sit",
    "build-sit-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run build-sit",
    "build-uat": "patch-package && cd packages/dss && npm run build-uat",
    "build-uat-ssllegacy": "cross-env NODE_OPTIONS=--openssl-legacy-provider && patch-package && cd packages/dss && npm run build-uat",
    "serve_cyeditor": "cd packages/cyeditor && npm run serve",
    "serve-sandbox": "npm run serve --configfile=config.sandbox.json",
    "build-sandbox": "npm run build --configfile=config.sandbox.json",
    "serve-scriptis": "npm run serve --module=scriptis --micro_module=scriptis",
    "build-scriptis": "npm run build --module=scriptis --micro_module=scriptis",
    "serve-apiServices": "npm run serve --module=apiServices,workspace --micro_module=apiServices",
    "build-apiServices": "npm run build --module=apiServices,workspace --micro_module=apiServices",
    "serve-scheduleCenter": "npm run serve --module=scheduleCenter,workflows,workspace,scriptis --micro_module=scheduleCenter",
    "build-scheduleCenter": "npm run build --module=scheduleCenter,workflows,workspace,scriptis --micro_module=scheduleCenter",
    "lint": "vue-cli-service lint --no-fix",
    "fix": "vue-cli-service lint --fix",
    "precommit": "lint-staged",
    "postinstall": "patch-package"
  },
  "husky": {
    "hooks": {
      "postcommit": "git update-index --again",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "packages/**/*.{js,vue}": [
      "vue-cli-service lint --no-fix",
      "git add"
    ]
  },
  "dependencies": {
    "axios": "1.12.0",
    "babel-polyfill": "6.26.0",
    "butterfly-dag": "4.1.23",
    "core-js": "2.6.11",
    "echarts": "^4.1.0",
    "iview": "3.5.4",
    "jsencrypt": "3.2.1",
    "lodash": "4.17.21",
    "md5": "2.3.0",
    "moment": "2.30.1",
    "monaco-editor": "0.30.1",
    "monaco-languageclient": "0.18.1",
    "qs": "6.9.7",
    "svgo": "1.3.0",
    "v-dragresize": "^1.0.5",
    "vue": "2.6.12",
    "vue-i18n": "8.22.1",
    "vue-router": "3.4.8",
    "vue-showdown": "^2.4.1",
    "vuescroll": "4.16.1",
    "web-worker": "^1.2.0",
    "webpack": "^4.46.0",
    "worker-loader": "2.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-transform-modules-commonjs": "7.24.1",
    "@kazupon/vue-i18n-loader": "0.4.1",
    "@vue/cli-plugin-babel": "3.12.1",
    "@vue/cli-plugin-eslint": "3.12.1",
    "@vue/cli-service": "3.12.1",
    "@vue/eslint-config-standard": "4.0.0",
    "any-observable": "^0.5.1",
    "archiver": "3.1.1",
    "babel-eslint": "10.1.0",
    "copy-webpack-plugin": "4.6.0",
    "cpr": "3.0.1",
    "cross-env": "^10.0.0",
    "csp-html-webpack-plugin": "4.0.0",
    "eslint": "6.8.0",
    "eslint-plugin-vue": "6.2.2",
    "filemanager-webpack-plugin": "2.0.5",
    "husky": "1.3.1",
    "less-loader": "6.1.0",
    "lint-staged": "8.2.1",
    "monaco-editor-webpack-plugin": "6.0.0",
    "patch-package": "6.2.2",
    "sass": "1.49.0",
    "sass-loader": "10.2.0",
    "speed-measure-webpack-plugin": "1.5.0",
    "svg-sprite-loader": "5.0.0",
    "vue-cli-plugin-mockjs": "0.1.3",
    "vue-template-compiler": "2.6.12",
    "webpack-virtual-modules": "0.3.2"
  },
  "workspaces": [
    "packages/apiServices",
    "packages/cyeditor",
    "packages/dataGovernance",
    "packages/dss",
    "packages/editor",
    "packages/editorLsp",
    "packages/exts",
    "packages/scheduleCenter",
    "packages/scriptis",
    "packages/shared",
    "packages/workflows",
    "packages/workspace"
  ]
}
