        </dependency>
        <dependency>
            <groupId>com.webank.wedatasphere.dss</groupId>
            <artifactId>dss-orchestrator-common-webank</artifactId>
            <version>${dss.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>


