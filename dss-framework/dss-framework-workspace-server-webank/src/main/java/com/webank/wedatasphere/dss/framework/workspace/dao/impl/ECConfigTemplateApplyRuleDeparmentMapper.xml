<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.webank.wedatasphere.dss.framework.workspace.dao.EcConfigTemplateApplyRuleDepartmentMapper">

    <resultMap id="BaseResultMap" type="com.webank.wedatasphere.dss.framework.workspace.dao.entity.ECConfigTemplateApplyRuleDepartmentDO">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="departmentName" column="department_name" jdbcType="VARCHAR"/>
            <result property="ruleId" column="rule_id" jdbcType="VARCHAR"/>
            <result property="workspaceId" column="workspace_id" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,department_name,rule_id,
        workspace_id,create_time
    </sql>

    <delete id="deleteByRuleId" parameterType="java.lang.String">
        delete from dss_ec_config_template_apply_rule_department
        where  rule_id = #{ruleId}
    </delete>

    <insert id="insertBatch" keyColumn="id" keyProperty="id" parameterType="com.webank.wedatasphere.dss.framework.workspace.dao.entity.ECConfigTemplateApplyRuleDepartmentDO" useGeneratedKeys="true">
        insert into dss_ec_config_template_apply_rule_department
        ( department_name,rule_id
        ,workspace_id,create_time)
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.departmentName,jdbcType=VARCHAR},#{item.ruleId,jdbcType=VARCHAR}
            ,#{item.workspaceId,jdbcType=BIGINT},NOW())
        </foreach>
    </insert>

    <select id="selectByRuleId" parameterType="java.lang.String" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from dss_ec_config_template_apply_rule_department
        where   rule_id = #{ruleId,jdbcType=VARCHAR}
    </select>

    <select id="selectBydDepartment" resultType="java.lang.String">
        select
        rule_id
        from dss_ec_config_template_apply_rule_department
        where department_name = #{departmentName,jdbcType=VARCHAR} and workspace_id = #{workspaceId,jdbcType=VARCHAR}
    </select>
</mapper>
