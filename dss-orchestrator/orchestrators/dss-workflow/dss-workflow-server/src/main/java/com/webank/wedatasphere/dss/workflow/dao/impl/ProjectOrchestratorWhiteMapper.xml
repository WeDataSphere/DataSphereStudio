<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.webank.wedatasphere.dss.workflow.dao.ProjectOrchestratorWhiteMapper">


    <select id="selectByProjectId" resultType="com.webank.wedatasphere.dss.workflow.entity.ProjectOrchestratorWhite">
        select * from dss_project_orchestrator_white where project_id = #{projectId} and orchestrator_id in (0,#{orchestratorId}) order by id desc limit 1;
    </select>


    <insert id="addProjectOrchestratorWhite">
        insert into dss_project_orchestrator_white (project_id,project_name,orchestrator_id,orchestrator_name,create_by,update_by,reason,type)
        values(#{projectId},#{projectName},#{orchestratorId},#{orchestratorName},#{createBy},#{updateBy},#{reason},#{type})
    </insert>

    <update id="updateById" parameterType="com.webank.wedatasphere.dss.workflow.entity.ProjectOrchestratorWhite">
        update dss_project_orchestrator_white set project_name= #{projectName}, orchestrator_name = #{orchestratorName},
        orchestrator_name = #{orchestratorName},update_by= #{updateBy},update_time=now()
        where id = #{id}
    </update>

    <delete id="deleteProjectWhite">
        delete from dss_project_orchestrator_white where project_id = #{projectId}
    </delete>

    <delete id="deleteProjectOrchestratorWhite">
        delete from dss_project_orchestrator_white where project_id = #{projectId} and orchestrator_id = #{orchestratorId}
    </delete>

    <select id="getWhiteListByProjectId" resultType="com.webank.wedatasphere.dss.workflow.entity.ProjectOrchestratorWhite">
        select * from dss_project_orchestrator_white where project_id = #{projectId}
    </select>

</mapper>