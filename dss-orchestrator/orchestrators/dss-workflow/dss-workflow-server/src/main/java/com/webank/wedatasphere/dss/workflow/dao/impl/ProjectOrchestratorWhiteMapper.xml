<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.webank.wedatasphere.dss.workflow.dao.ProjectOrchestratorWhiteMapper">


    <select id="selectByProjectId" resultType="com.webank.wedatasphere.dss.workflow.entity.ProjectOrchestratorWhite">
        select * from dss_project_orchestrator_white where project_id = #{projectId} and orchestrator_id in ('*',#{orchestratorId}) order by id desc limit 1;
    </select>


    <insert id="addProjectOrchestratorWhite">
        insert into dss_project_orchestrator_white (project_id,project_name,orchestrator_id,orchestrator_name,create_by,update_by)
        values(#{projectId},#{projectName},#{orchestratorId},#{orchestratorName},#{createBy},#{updateBy})
    </insert>

    <update id="updateById" parameterType="com.webank.wedatasphere.dss.workflow.entity.ProjectOrchestratorWhite">
        update dss_project_orchestrator_white set project_name= #{projectName}, orchestrator_name = #{orchestratorName},
        orchestrator_name = #{orchestrator_name},update_by= #{updateBy}
        where id = #{id}
    </update>

</mapper>